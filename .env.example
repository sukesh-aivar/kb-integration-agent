# Copy to .env and fill in. NEVER commit a real .env (it is git-ignored).
# All values here are placeholders. Several map to OPEN_QUESTIONS entries and
# must be confirmed before any AWS-backed run (see OPEN_QUESTIONS.md).

# --- AWS environment ---
# TODO(confirm) OPEN_QUESTIONS Q6: InfoSec-approved region + BDA availability/quota.
KB_AGENT_AWS_REGION=us-west-2
# S3 bucket the agent reads uploads from and writes derived artefacts to.
KB_AGENT_S3_BUCKET=REPLACE_ME_placeholder-bucket
# Prefix under which this run's inputs/outputs live. Normally injected per run.
KB_AGENT_S3_PREFIX=kb-agent

# --- Model IDs ---
# TODO(confirm) OPEN_QUESTIONS Q11: exact embedding + Claude model IDs to pin.
KB_AGENT_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
KB_AGENT_LLM_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0

# --- Bedrock Guardrails (PII filtering) ---
# TODO(confirm): Guardrail identifier + version provisioned for the pilot.
KB_AGENT_GUARDRAIL_ID=REPLACE_ME_placeholder-guardrail
KB_AGENT_GUARDRAIL_VERSION=DRAFT

# --- Observability ---
# OTEL exporter endpoint. Leave blank for a local no-op exporter.
KB_AGENT_OTEL_ENDPOINT=
KB_AGENT_LOG_LEVEL=INFO

# --- freq-test branch: real KB-with-S3-Vectors run (Path A, KB internal parser) ---
# Credentials come from the standard AWS env vars (NOT KB_AGENT_-prefixed):
#   AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY  (+ AWS_SESSION_TOKEN if temporary)
#
# IAM role the Bedrock Knowledge Base SERVICE assumes (not the agent). It needs
# s3:GetObject/ListBucket on the bucket, bedrock:InvokeModel on the embedding
# model, and s3vectors:* on your vector bucket/index.
KB_AGENT_KB_ROLE_ARN=
# S3 Vectors INDEX ARN (passed as s3VectorsConfiguration.indexArn). Index
# dimension MUST match the embedding model (Titan Text Embeddings V2 = 1024),
# metric cosine.
KB_AGENT_VECTOR_INDEX_ARN=
# Disable the Bedrock Guardrails API call for this test (regex PII still runs).
KB_AGENT_GUARDRAIL_ENABLED=false
# Only needed for the BDA document path (not Path A); leave blank for Path A.
KB_AGENT_BDA_PROJECT_ARN=
